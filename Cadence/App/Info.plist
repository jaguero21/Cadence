<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Cadence</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>Cadence reads your sleep, heart rate and heart rate variability, workouts and activity, respiratory rate, blood oxygen, wrist temperature, time in daylight, mindful minutes, caffeine and water intake, cycle tracking, and any symptoms or moods recorded in Health. It uses them to prefill your daily log and to find patterns in how you feel. Health access is optional — every value can be entered by hand and nothing in Cadence is gated on it.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Cadence can write the symptoms you log and your daily mood back to Health, so they sit alongside the rest of your health record. This is optional, only ever adds entries Cadence itself created, and declining it never affects logging in Cadence.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cadence uses the microphone so you can attach short voice notes to a daily log.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<!-- Paired with the aps-environment entitlement, and required for the same
	     reason: SwiftData's CloudKit mirroring runs on
	     NSPersistentCloudKitContainer, which imports remote changes when a
	     silent CloudKit push wakes the app. Without this background mode the
	     push is not delivered while backgrounded, so a log written on another
	     device does not appear until Cadence is launched again. This is the
	     setup Apple's own Core Data + CloudKit configuration prescribes, so it
	     is an "intended purpose" under Guideline 2.5.4 — it is not the unused
	     push capability it can look like from a grep of the Swift sources.
	     HealthKit background delivery is separate and does NOT need this key. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
</dict>
</plist>
